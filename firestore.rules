rules_version = '2';

// EduTask Firestore security rules.
//
// • Students can only read and write their own profile, tasks, quiz results,
//   notifications and unfinished quiz sessions. The UID always comes from
//   Firebase Auth (request.auth.uid) — a userId sent by the client is never trusted.
// • Quiz content (subjectFields, subjects, questions) is read-only for students.
//   Only accounts with the custom claim `admin: true` may write it
//   (the seed tool uses the Admin SDK, which bypasses rules entirely).
//   Legacy trueFalseQuestions rules remain for cleanup; the app loads T/F from local JSON.
// • Nothing is ever open with `if true`.
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────────────
    function signedIn() { return request.auth != null; }
    function isUser(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function incoming() { return request.resource.data; }
    function text(v, min, max) { return v is string && v.trim().size() >= min && v.size() <= max; }
    function intIn(v, min, max) { return v is int && v >= min && v <= max; }
    // "Multiple choice" (A–D) or "Quiz" (True / False). Older documents have no
    // quizType and count as multipleChoice, so the field stays optional.
    function validQuizType(d) { return !('quizType' in d) || d.quizType in ['multipleChoice', 'trueFalse']; }

    // ── users/{uid} ─────────────────────────────────────────────────────
    match /users/{userId} {
      allow get: if isUser(userId);
      allow list: if false;

      allow create: if isUser(userId)
        && incoming().keys().hasAll(['uid', 'displayName', 'email', 'createdAt', 'updatedAt'])
        && incoming().keys().hasOnly(['uid', 'displayName', 'email', 'createdAt', 'updatedAt'])
        && incoming().uid == userId
        && text(incoming().displayName, 1, 60)
        && incoming().email is string
        && incoming().email.lower() == request.auth.token.email.lower()
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      // Only the display name can change; uid, email and createdAt are fixed.
      allow update: if isUser(userId)
        && incoming().diff(resource.data).affectedKeys().hasOnly(['displayName', 'updatedAt'])
        && text(incoming().displayName, 1, 60)
        && incoming().updatedAt == request.time;

      allow delete: if false;

      // ── users/{uid}/quizSessions/{sessionId} — unfinished quizzes ────
      match /quizSessions/{sessionId} {
        allow read, delete: if isUser(userId);
        allow create, update: if isUser(userId) && validSession(incoming());
      }
    }

    function validSession(d) {
      return d.keys().hasOnly(['quizType', 'subjectId', 'subjectName', 'subjectCode', 'level', 'questionIds', 'answers', 'checked',
                               'currentIndex', 'remainingSeconds', 'resultId', 'startedAt', 'updatedAt'])
        && validQuizType(d)
        && text(d.subjectId, 1, 100)
        && d.subjectName is string && d.subjectCode is string
        && intIn(d.level, 1, 15)
        && d.questionIds is list && d.questionIds.size() == 10
        && d.answers is map && d.answers.size() <= 10
        && d.checked is list && d.checked.size() <= 10
        && intIn(d.currentIndex, 0, 9)
        && d.remainingSeconds is number && d.remainingSeconds >= 0 && d.remainingSeconds <= 600
        && text(d.resultId, 1, 100)
        && d.startedAt is timestamp
        && d.updatedAt == request.time;
    }

    // ── quizResults/{resultId} ──────────────────────────────────────────
    match /quizResults/{resultId} {
      // `resource == null` lets the app check whether a result exists
      // (retry after a timeout) without revealing anything.
      allow get: if signedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow list: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && validResult(incoming());
      // Results are permanent: no edits, no deletes from the app.
      allow update, delete: if false;
    }

    function validResult(d) {
      return d.keys().hasAll(['userId', 'subjectId', 'subjectName', 'subjectCode', 'level', 'totalQuestions', 'correctAnswers',
                              'incorrectAnswers', 'score', 'percentage', 'durationSeconds', 'answers', 'completedAt'])
        && d.keys().hasOnly(['userId', 'quizType', 'subjectId', 'subjectName', 'subjectCode', 'level', 'totalQuestions', 'correctAnswers',
                             'incorrectAnswers', 'score', 'percentage', 'durationSeconds', 'answers', 'completedAt'])
        && validQuizType(d)
        && d.userId == request.auth.uid
        && text(d.subjectId, 1, 100)
        && exists(/databases/$(database)/documents/subjects/$(d.subjectId))
        && d.subjectName is string && d.subjectCode is string
        && intIn(d.level, 1, 15)
        && d.totalQuestions == 10
        && intIn(d.correctAnswers, 0, 10)
        && d.incorrectAnswers == d.totalQuestions - d.correctAnswers
        && d.score == d.correctAnswers
        && d.percentage == d.correctAnswers * 10
        && intIn(d.durationSeconds, 0, 3600)
        && d.answers is list && d.answers.size() == d.totalQuestions
        && d.completedAt == request.time;
    }

    // ── notifications/{notificationId} — inbox ──────────────────────────
    match /notifications/{notificationId} {
      allow get: if signedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow list: if signedIn() && resource.data.userId == request.auth.uid;

      allow create: if signedIn()
        && incoming().userId == request.auth.uid
        && validNotification(incoming())
        && incoming().read == false
        && incoming().createdAt == request.time;

      // Students may only flip read → true (or leave it unchanged).
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && incoming().userId == resource.data.userId
        && incoming().dedupeKey == resource.data.dedupeKey
        && incoming().type == resource.data.type
        && incoming().title == resource.data.title
        && incoming().body == resource.data.body
        && incoming().createdAt == resource.data.createdAt
        && incoming().read is bool
        && validNotification(incoming());

      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    function validNotification(d) {
      return d.keys().hasAll(['userId', 'type', 'title', 'body', 'read', 'dedupeKey', 'createdAt'])
        && d.keys().hasOnly(['userId', 'type', 'title', 'body', 'read', 'dedupeKey', 'createdAt',
                             'taskId', 'resultId', 'subjectId', 'level', 'quizType'])
        && d.type in ['taskDue', 'taskOverdue', 'quizCompleted']
        && text(d.title, 1, 120)
        && text(d.body, 1, 500)
        && d.read is bool
        && text(d.dedupeKey, 1, 200)
        && (!('taskId' in d) || text(d.taskId, 1, 100))
        && (!('resultId' in d) || text(d.resultId, 1, 100))
        && (!('subjectId' in d) || text(d.subjectId, 1, 100))
        && (!('level' in d) || intIn(d.level, 1, 15))
        && (!('quizType' in d) || d.quizType in ['multipleChoice', 'trueFalse']);
    }

    // ── tasks/{taskId} ──────────────────────────────────────────────────
    match /tasks/{taskId} {
      allow get: if signedIn() && (resource == null || resource.data.userId == request.auth.uid);
      // Queries must filter on userId == own uid, otherwise they're rejected.
      allow list: if signedIn() && resource.data.userId == request.auth.uid;

      allow create: if signedIn()
        && incoming().userId == request.auth.uid
        && validTask(incoming())
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && incoming().userId == resource.data.userId       // can't hand a task to someone else
        && incoming().createdAt == resource.data.createdAt // creation time is fixed
        && incoming().updatedAt == request.time
        && validTask(incoming());

      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    function validTask(d) {
      return d.keys().hasAll(['userId', 'title', 'description', 'subjectId', 'dueDate', 'priority', 'status', 'completedAt', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['userId', 'title', 'description', 'subjectId', 'dueDate', 'priority', 'status', 'completedAt', 'createdAt', 'updatedAt'])
        && text(d.title, 1, 80)
        && d.description is string && d.description.size() <= 500
        && text(d.subjectId, 1, 100)
        && d.dueDate is timestamp
        && d.priority in ['low', 'medium', 'high']
        && ((d.status == 'pending' && d.completedAt == null) || (d.status == 'completed' && d.completedAt is timestamp));
    }

    // ── Academic content: read-only for students ────────────────────────
    match /subjectFields/{fieldId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /subjects/{subjectId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /questions/{questionId} {            // Multiple choice (A–D)
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /trueFalseQuestions/{questionId} {   // Quiz (True / False)
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Anything not matched above is denied by default.
  }
}
