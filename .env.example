# Firebase web app config for EduTask (required — the app has no offline/demo mode).
# Firebase console → Project settings → General → Your apps → Web app → Config.
# Copy to `.env`, fill in, then restart with: npx expo start -c
#
# These identify your project and are safe in a client app; data is protected
# by firestore.rules. NEVER put a service-account / Admin SDK key here — every
# EXPO_PUBLIC_ value is bundled into the app.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
